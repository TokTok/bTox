#!/usr/bin/env bash

# Copies the sync conformance cases from an rs-toxcore-c checkout, by default
# the one next to this one, into test/sync/conformance.

set -euo pipefail

BTOX="$(dirname "$0")/.."
SOURCE="${1:-$BTOX/../rs-toxcore-c}"

rm -f "$BTOX"/test/sync/conformance/*.json
cp "$SOURCE"/sync/conformance/{*.json,README.md} "$BTOX"/test/sync/conformance/
