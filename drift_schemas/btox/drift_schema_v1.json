  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"stay_online\" INTEGER NOT NULL DEFAULT 1 CHECK (\"stay_online\" IN (0, 1)), \"auto_accept_file_size\" INTEGER NOT NULL DEFAULT 4194304, \"current_profile\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_bootstrap_nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_bootstrap_nodes\" (\"id\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"signed_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"signed_in\" IN (0, 1)), \"settings\" TEXT NOT NULL, \"secret_key\" TEXT NOT NULL CHECK(LENGTH(\"secret_key\") = 64), \"public_key\" TEXT NOT NULL CHECK(LENGTH(\"public_key\") = 64), \"nospam\" INTEGER NOT NULL CHECK(\"nospam\" BETWEEN 0 AND 4294967295));"
        }
      ]
    },
    {
      "name": "contacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"contacts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"name\" TEXT NULL, \"public_key\" TEXT NOT NULL, \"friend_request_address\" TEXT NULL, \"friend_request_message\" TEXT NULL, \"online\" INTEGER NOT NULL DEFAULT 0 CHECK (\"online\" IN (0, 1)), \"last_read_message\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "friend_requests",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"friend_requests\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"public_key\" TEXT NOT NULL, \"message\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, UNIQUE (\"profile_id\", \"public_key\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"contact_id\" INTEGER NOT NULL REFERENCES contacts (id), \"author\" TEXT NOT NULL, \"sha\" TEXT NOT NULL CHECK(LENGTH(\"sha\") = 64), \"parent\" INTEGER NULL REFERENCES messages (id), \"merged\" INTEGER NULL REFERENCES messages (id), \"timestamp\" INTEGER NOT NULL, \"content\" TEXT NOT NULL, \"delivered\" INTEGER NULL CHECK (\"delivered\" IN (0, 1)), \"file_state\" TEXT NULL, \"file_transferred\" INTEGER NULL);"
        }
      ]
    }
  ]
